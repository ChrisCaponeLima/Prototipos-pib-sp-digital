generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cofre_ativos {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria           String    @db.VarChar(50)
  nome_ativo          String    @db.VarChar(100)
  plataforma          String?   @db.VarChar(100)
  url_acesso          String?
  login_usuario       String?
  senha_criptografada String?
  email_resgate       String?
  responsavel_atual   String?   @db.VarChar(100)
  status_2fa          String?   @db.VarChar(50)
  observacoes         String?
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
}

model pmo_diario_bordo {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo         String        @db.VarChar(200)
  resumo_decisao String
  autor_id       String?       @db.Uuid
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  status         String?       @default("concluido") @db.VarChar(50)
  pmo_usuarios   pmo_usuarios? @relation(fields: [autor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pmo_tarefas {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo         String        @db.VarChar(200)
  descricao      String?
  fase           String        @db.VarChar(20)
  status         String        @db.VarChar(20)
  prioridade     String        @db.VarChar(10)
  responsavel_id String?       @db.Uuid
  updated_at     DateTime?     @default(now()) @db.Timestamp(6)
  Impeditivo     Boolean?
  pmo_usuarios   pmo_usuarios? @relation(fields: [responsavel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pmo_usuarios {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String             @db.VarChar(100)
  email            String             @unique @db.VarChar(150)
  password_hash    String
  funcao           String             @db.VarChar(50)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  login            String             @db.VarChar(20)
  pmo_diario_bordo pmo_diario_bordo[]
  pmo_logs_login   pmo_logs_login[]
  pmo_tarefas      pmo_tarefas[]
}

model pmo_logs_login {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String?       @db.Uuid
  email        String        @db.VarChar(255)
  status       String        @db.VarChar(20)
  ip           String?       @db.VarChar(45)
  user_agent   String?
  detalhes     String?
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  pmo_usuarios pmo_usuarios? @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([email], map: "idx_pmo_logs_login_email")
  @@index([usuario_id], map: "idx_pmo_logs_login_usuario_id")
}
